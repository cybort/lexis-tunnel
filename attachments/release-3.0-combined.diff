@@ -0,0 +1,41 @@
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import test from "node:test";
+import { buildTcpPacket, buildUdpPacket, createEngine } from "../public/agent/lexis-tun.mjs";
+
+const GATE = "10.240.2.2";
+function rig() {
+  const dials = [], drops = [];
+  const engine = createEngine({
+    dialTcp: async (h, p) => { dials.push(`tcp ${h}:${p}`); throw new Error("no"); },
+    dialUdp: async (h, p) => { dials.push(`udp ${h}:${p}`); throw new Error("no"); },
+    emit: () => undefined,
+    loopGuard: [GATE],
+    onLoopDrop: (ip) => drops.push(ip.dst),
+  });
+  return { engine, dials, drops };
+}
+
+test("loop guard: packets to a peer are dropped, never dialled", async () => {
+  const { engine, dials, drops } = rig();
+  await engine.push(buildTcpPacket({ src: "10.7.0.1", dst: GATE, sport: 40000, dport: 18443, seq: 1, ack: 0, flags: 0x02 }));
+  await engine.push(buildUdpPacket({ src: "10.7.0.1", dst: GATE, sport: 40001, dport: 18443, payload: Buffer.from("x") }));
+  assert.deepEqual(drops, [GATE, GATE]);
+  assert.deepEqual(dials, []);
+  engine.close();
+});
+
+test("loop guard: other destinations still dial", async () => {
+  const { engine, dials, drops } = rig();
+  await engine.push(buildTcpPacket({ src: "10.7.0.1", dst: "45.67.90.10", sport: 40002, dport: 80, seq: 1, ack: 0, flags: 0x02 }));
+  await new Promise((r) => setTimeout(r, 20));
+  assert.deepEqual(drops, []);
+  assert.equal(dials.length, 1);
+  engine.close();
+});
+
+test("tun install script blocks peers after main lookup (unreachable, before the tun table)", () => {
+  const src = fs.readFileSync(new URL("../public/agent/lexis-agent.mjs", import.meta.url), "utf8");
+  const m = src.match(/prio=150\n\s+for ip in \$PEERS; do[\s\S]*?ip rule add to "\$ip\/32" unreachable priority "\$prio"[\s\S]*?done\n\s+ip route replace default dev lexis0 table "\$TABLE"/);
+  assert.ok(m, "unreachable rules for peers present between fwmark(100) and tun table(200)");
+});
diff --git a/scripts/lexis-tun-script.test.mjs b/scripts/lexis-tun-script.test.mjs
new file mode 100644
index 0000000..c80a6c9
--- /dev/null
+++ b/scripts/lexis-tun-script.test.mjs
@@ -0,0 +1,56 @@
+// Runs the generated Linux tun apply-forward.sh against fake `id`/`ip` binaries and checks
+// the rules it would install (loop guard for peers, linux.ipv6 block/off).
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import test from "node:test";
+
+const src = fs.readFileSync(new URL("../public/agent/lexis-agent.mjs", import.meta.url), "utf8");
+function extract(name) {
+  const i = src.indexOf(name);
+  let d = 0, j = src.indexOf("{", i);
+  for (let k = j; k < src.length; k++) { if (src[k] === "{") d++; else if (src[k] === "}" && --d === 0) { j = k + 1; break; } }
+  return src.slice(i, j);
+}
+const forwardScript = new Function("platform", "transparentPort", "GEOIP",
+  extract("function peerAddrs(") + "\n" + extract("function forwardScript(") + "; return forwardScript;")(() => "linux", () => 12345, { private: [] });
+
+function runScript(linux) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "lexis-fwd-"));
+  const logf = path.join(dir, "ip.log");
+  fs.writeFileSync(path.join(dir, "id"), "#!/bin/sh\necho 0\n", { mode: 0o755 });
+  fs.writeFileSync(path.join(dir, "ip"), `#!/bin/sh\necho "$*" >> ${logf}\ncase "$*" in "link show"*) exit 1;; "-6 rule del"*|"rule del"*) exit 1;; esac\nexit 0\n`, { mode: 0o755 });
+  const { body } = forwardScript({ mode: "system-forward", linux: { method: "tun", mark: 4731, table: 165, ...linux }, peers: [{ endpoint: "10.240.2.2:18443" }, { endpoint: "203.0.113.9:7000" }] });
+  const sh = path.join(dir, "apply.sh");
+  fs.writeFileSync(sh, body, { mode: 0o755 });
+  const out = execFileSync("/bin/sh", [sh], { env: { PATH: `${dir}:/usr/bin:/bin` }, encoding: "utf8" });
+  const log = fs.readFileSync(logf, "utf8").trim().split("\n");
+  fs.rmSync(dir, { recursive: true, force: true });
+  return { out, log };
+}
+const idx = (log, re) => log.findIndex((l) => re.test(l));
+
+test("tun script: each peer gets main lookup then unreachable, both before the tun table rule", () => {
+  const { log } = runScript({});
+  for (const peer of ["10.240.2.2", "203.0.113.9"]) {
+    const main = idx(log, new RegExp(`^rule add to ${peer}/32 lookup main priority 4\\d$`));
+    const unr = idx(log, new RegExp(`^rule add to ${peer}/32 unreachable priority 15\\d$`));
+    assert.ok(main >= 0 && unr > main, `${peer}: ${log.join(" | ")}`);
+  }
+  assert.ok(idx(log, /^rule add lookup 165 priority 200$/) >= 0);
+});
+
+test("tun script: linux.ipv6 defaults to block (unreachable default in the tun table, local ranges kept)", () => {
+  const { log, out } = runScript({});
+  assert.ok(idx(log, /^-6 route replace unreachable default table 165$/) >= 0, log.join(" | "));
+  assert.ok(idx(log, /^-6 rule add lookup 165 priority 200$/) >= 0);
+  for (const net of ["::1/128", "fe80::/10", "fc00::/7", "ff00::/8"]) assert.ok(idx(log, new RegExp(`^-6 rule add to ${net.replace(/[/.]/g, "\\$&")} lookup main`)) >= 0, net);
+  assert.match(out, /IPv6 已设为不可达/);
+});
+
+test("tun script: linux.ipv6 = off leaves IPv6 alone", () => {
+  const { log } = runScript({ ipv6: "off" });
+  assert.equal(log.filter((l) => l.startsWith("-6 rule add") || l.startsWith("-6 route replace")).length, 0, log.join(" | "));
+});
diff --git a/scripts/lexis-udp-rebuild.test.mjs b/scripts/lexis-udp-rebuild.test.mjs
new file mode 100644
index 0000000..032e001
--- /dev/null
+++ b/scripts/lexis-udp-rebuild.test.mjs
@@ -0,0 +1,52 @@
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import test from "node:test";
+
+const src = fs.readFileSync(new URL("../public/agent/lexis-agent.mjs", import.meta.url), "utf8");
+function extract(name) {
+  const i = src.indexOf(name);
+  let d = 0, j = src.indexOf(") {\n", i) + 2;
+  for (let k = j; k < src.length; k++) { if (src[k] === "{") d++; else if (src[k] === "}" && --d === 0) { j = k + 1; break; } }
+  return src.slice(i, j);
+}
+const make = () => new Function("let udpRebuildRetries = 0; const sessionFor = null; const REBUILD_WAIT_MS = 3000;\n" + extract("async function openAcrossRebuild(") + "; return { openAcrossRebuild, retries: () => udpRebuildRetries };")();
+
+const fakeSession = (behaviour) => ({ closed: false, opens: 0, async open(cmd) { this.opens++; return behaviour(this, cmd); } });
+
+test("open on a live session: no retry", async () => {
+  const { openAcrossRebuild, retries } = make();
+  const s = fakeSession(() => "stream");
+  assert.equal(await openAcrossRebuild({}, {}, "udp a 53", { open: async () => s }), "stream");
+  assert.equal(retries(), 0);
+});
+
+test("session closes during open: waits for the rebuilt session and retries once", async () => {
+  const { openAcrossRebuild, retries } = make();
+  const old = fakeSession((self) => { self.closed = true; throw new Error("连接关闭"); });
+  const fresh = fakeSession(() => "stream2");
+  let calls = 0;
+  // first lookup returns the dying session, the next still returns it (not yet evicted), then the rebuilt one after 120 ms
+  const t0 = Date.now();
+  const open = async () => (++calls <= 2 ? old : (await new Promise((r) => setTimeout(r, Math.max(0, 120 - (Date.now() - t0)))), fresh));
+  assert.equal(await openAcrossRebuild({}, {}, "udp a 53", { open }), "stream2");
+  assert.equal(fresh.opens, 1);
+  assert.equal(retries(), 1);
+});
+
+test("open fails on a session that is still up (e.g. remote refused): error passes through, no retry", async () => {
+  const { openAcrossRebuild } = make();
+  const s = fakeSession(() => { throw new Error("对端拒绝"); });
+  let calls = 0;
+  await assert.rejects(openAcrossRebuild({}, {}, "udp a 53", { open: async () => (calls++, s) }), /对端拒绝/);
+  assert.equal(calls, 1);
+});
+
+test("rebuild slower than the wait budget: original error after the budget", async () => {
+  const { openAcrossRebuild } = make();
+  const old = fakeSession((self) => { self.closed = true; throw new Error("连接关闭"); });
+  let calls = 0;
+  const open = async () => (++calls === 1 ? old : new Promise(() => undefined));
+  const t0 = Date.now();
+  await assert.rejects(openAcrossRebuild({}, {}, "udp a 53", { open, waitMs: 200 }), /连接关闭/);
+  assert.ok(Date.now() - t0 >= 190 && Date.now() - t0 < 1000);
+});
