index 0000000..ff09d7d
--- /dev/null
+++ b/scripts/lexis-http-conn.test.mjs
@@ -0,0 +1,119 @@
+import assert from "node:assert/strict";
+import { connect, createServer } from "node:net";
+import test from "node:test";
+import { serveHttpProxy } from "../public/agent/lexis-http.mjs";
+
+function listen(handler) {
+  const server = createServer((socket) => { socket.on("error", () => socket.destroy()); handler(socket); });
+  return new Promise((resolve) => server.listen(0, "127.0.0.1", () => resolve(server)));
+}
+
+// Upstream answers one request with the given raw head + body, then closes (mode none) or stays idle.
+async function setup(respHead, body, closeAfter) {
+  const upstream = await listen((s) => {
+    s.once("data", () => { s.write(respHead + body); if (closeAfter) s.end(); });
+  });
+  const proxy = await listen((s) => {
+    void serveHttpProxy(s, { openUpstream: (h, p) => new Promise((r) => { const u = connect(p, h, () => r(u)); u.on("error", () => {}); }) });
+  });
+  return { upstream, proxy, uport: upstream.address().port, pport: proxy.address().port };
+}
+
+function exchange(pport, req) {
+  return new Promise((resolve, reject) => {
+    const s = connect(pport, "127.0.0.1", () => s.write(req));
+    let buf = "";
+    const timer = setTimeout(() => { s.destroy(); resolve({ buf, closed: false }); }, 400);
+    s.on("data", (d) => { buf += d.toString("latin1"); });
+    s.on("end", () => { clearTimeout(timer); s.destroy(); resolve({ buf, closed: true }); });
+    s.on("error", reject);
+  });
+}
+
+const cases = [
+  { name: "客户端 close", ver: "1.1", reqConn: "close", resp: "Content-Length: 2\r\n", want: "close" },
+  { name: "上游 close 不影响客户端", ver: "1.1", reqConn: "", resp: "Content-Length: 2\r\nConnection: close\r\n", want: "keep-alive" },
+  { name: "双方都不带 close", ver: "1.1", reqConn: "", resp: "Content-Length: 2\r\n", want: "keep-alive" },
+  { name: "HTTP/1.0 不带 keep-alive", ver: "1.0", reqConn: "", resp: "Content-Length: 2\r\n", want: "close" },
+  { name: "HTTP/1.0 带 keep-alive", ver: "1.0", reqConn: "keep-alive", resp: "Content-Length: 2\r\n", want: "keep-alive" },
+  { name: "长度未知 mode none", ver: "1.1", reqConn: "", resp: "", want: "close", closeAfter: true },
+];
+
+for (const c of cases) {
+  test(`Connection 处理：${c.name}`, async () => {
+    const env = await setup(`HTTP/1.1 200 OK\r\n${c.resp}\r\n`, "ok", c.closeAfter);
+    try {
+      const req = `GET http://127.0.0.1:${env.uport}/ HTTP/${c.ver}\r\nHost: 127.0.0.1:${env.uport}\r\n${c.reqConn ? `Connection: ${c.reqConn}\r\n` : ""}\r\n`;
+      const { buf, closed } = await exchange(env.pport, req);
+      const head = buf.split("\r\n\r\n")[0];
+      assert.match(head, /^HTTP\/1\.1 200/);
+      const conns = head.match(/^connection:.*$/gim) || [];
+      assert.deepEqual(conns.map((l) => l.split(":")[1].trim().toLowerCase()), [c.want]);
+      assert.ok(buf.endsWith("ok"));
+      assert.equal(closed, c.want === "close", `连接${c.want === "close" ? "应" : "不应"}被代理关闭`);
+    } finally { env.upstream.close(); env.proxy.close(); }
+  });
+}
+
+// Read exactly one Content-Length response from a persistent client socket.
+function readOne(s) {
+  return new Promise((resolve, reject) => {
+    let buf = "";
+    const timer = setTimeout(() => { s.off("data", on); reject(new Error(`响应超时 ${buf.slice(0, 120)}`)); }, 1500);
+    const on = (d) => {
+      buf += d.toString("latin1");
+      const at = buf.indexOf("\r\n\r\n");
+      if (at < 0) return;
+      const len = Number((buf.slice(0, at).match(/^content-length:\s*(\d+)/im) || [])[1]);
+      if (buf.length < at + 4 + len) return;
+      clearTimeout(timer); s.off("data", on);
+      resolve({ head: buf.slice(0, at), body: buf.slice(at + 4, at + 4 + len) });
+    };
+    s.on("data", on);
+  });
+}
+
+async function pathServer(conn) {
+  return listen((s) => s.once("data", (d) => {
+    const path = d.toString("latin1").split(" ")[1];
+    const body = `ok ${path}`;
+    s.write(`HTTP/1.1 200 OK\r\nContent-Length: ${body.length}\r\n${conn ? `Connection: ${conn}\r\n` : ""}\r\n${body}`);
+    if (conn === "close") s.end();
+  }));
+}
+
+async function reuse(origins, ver, reqConn) {
+  const ups = await Promise.all(origins.map((c) => pathServer(c)));
+  let accepted = 0;
+  const proxy = await listen((s) => { accepted++; void serveHttpProxy(s, { openUpstream: (h, p) => new Promise((r) => { const u = connect(p, h, () => r(u)); u.on("error", () => {}); }) }); });
+  const s = connect(proxy.address().port, "127.0.0.1");
+  await new Promise((r) => s.once("connect", r));
+  let closed = false; s.on("end", () => { closed = true; });
+  const out = [];
+  try {
+    for (let i = 0; i < ups.length; i++) {
+      const port = ups[i].address().port;
+      const pending = readOne(s);
+      s.write(`GET http://127.0.0.1:${port}/r${i} HTTP/${ver}\r\nHost: 127.0.0.1:${port}\r\nConnection: ${reqConn}\r\n\r\n`);
+      out.push(await pending);
+    }
+    await new Promise((r) => setTimeout(r, 100));
+    return { out, closed, accepted };
+  } finally { s.destroy(); proxy.close(); for (const u of ups) u.close(); }
+}
+
+test("HTTP/1.0 带 keep-alive：同一连接连发两次都成功并复用", async () => {
+  const { out, closed, accepted } = await reuse(["", ""], "1.0", "keep-alive");
+  assert.deepEqual(out.map((r) => r.body), ["ok /r0", "ok /r1"]);
+  for (const r of out) assert.match(r.head, /^connection: keep-alive$/im);
+  assert.equal(accepted, 1);
+  assert.equal(closed, false);
+});
+
+test("同一连接访问两个上游，其中一个回 close：两次都成功", async () => {
+  const { out, closed, accepted } = await reuse(["close", ""], "1.1", "keep-alive");
+  assert.deepEqual(out.map((r) => r.body), ["ok /r0", "ok /r1"]);
+  for (const r of out) assert.match(r.head, /^connection: keep-alive$/im);
+  assert.equal(accepted, 1);
+  assert.equal(closed, false);
+});
diff --git a/scripts/lexis-tun-flowgc.test.mjs b/scripts/lexis-tun-flowgc.test.mjs
new file mode 100644
index 0000000..8890ac5
--- /dev/null
+++ b/scripts/lexis-tun-flowgc.test.mjs
@@ -0,0 +1,72 @@
+import assert from "node:assert/strict";
+import net from "node:net";
+import test from "node:test";
+import { buildTcpPacket, createEngine, parseIpv4, parseTcp } from "../public/agent/lexis-tun.mjs";
+
+const SYN = 0x02, ACK = 0x10, FIN = 0x01, RST = 0x04, PSH = 0x08;
+const C = "10.99.0.2", S = "10.99.0.1";
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+
+async function rig({ serverEnds, ...opts }) {
+  const sockets = [];
+  const srv = net.createServer((s) => {
+    sockets.push(s);
+    s.on("error", () => undefined);
+    s.on("data", (d) => s.write(d));
+    if (serverEnds) s.on("end", () => s.end());
+  });
+  await new Promise((r) => srv.listen(0, "127.0.0.1", r));
+  const port = srv.address().port;
+  const seen = [];
+  const engine = createEngine({
+    dialTcp: () => new Promise((res, rej) => { const s = net.connect(port, "127.0.0.1", () => res(s)); s.once("error", rej); }),
+    dialUdp: async () => { throw new Error("no udp"); },
+    emit: (pkt) => setImmediate(() => seen.push(parseTcp(parseIpv4(pkt).payload))),
+    ...opts,
+  });
+  let cseq = 1000, ack = 0;
+  const send = (flags, payload) => engine.push(buildTcpPacket({ src: C, dst: S, sport: 40000, dport: 80, seq: cseq, ack, flags, payload }));
+  const waitFor = async (pred) => { for (let i = 0; i < 200; i++) { const hit = seen.find(pred); if (hit) return hit; await sleep(5); } return null; };
+  const done = () => { engine.close(); srv.close(); for (const s of sockets) s.destroy(); };
+  // handshake + 3 bytes + FIN
+  await send(SYN);
+  const synAck = await waitFor((t) => (t.flags & SYN) && (t.flags & ACK));
+  ack = (synAck.seq + 1) >>> 0; cseq++;
+  await send(ACK);
+  await send(ACK | PSH, Buffer.from("abc")); cseq += 3;
+  await send(ACK | FIN); cseq++;
+  return { engine, seen, send, waitFor, done, ackTo: (v) => { ack = v >>> 0; }, finSeq: () => cseq - 1, setSeq: (v) => { cseq = v; } };
+}
+
+test("gracefully closed tun flow is dropped after TIME_WAIT", async () => {
+  const r = await rig({ serverEnds: true, timeWaitMs: 60 });
+  try {
+    const fin = await r.waitFor((t) => t.flags & FIN);
+    assert.ok(fin, "engine sends FIN after remote close");
+    r.ackTo(fin.seq + fin.data.length + 1);
+    await r.send(ACK);
+    await sleep(10);
+    // Retransmitted FIN during TIME_WAIT still gets an ACK.
+    r.seen.length = 0;
+    r.setSeq(r.finSeq());
+    await r.send(ACK | FIN);
+    assert.ok(await r.waitFor((t) => t.flags === ACK), "ACK during TIME_WAIT");
+    await sleep(120);
+    r.seen.length = 0;
+    await r.send(ACK | FIN);
+    await sleep(40);
+    assert.equal(r.seen.length, 0, "flow forgotten after TIME_WAIT");
+  } finally {
+    r.done();
+  }
+});
+
+test("half-closed tun flow is reset after finLingerMs", async () => {
+  const r = await rig({ serverEnds: false, finLingerMs: 80 });
+  try {
+    const rst = await r.waitFor((t) => t.flags & RST);
+    assert.ok(rst, "RST after linger");
+  } finally {
+    r.done();
+  }
+});
diff --git a/scripts/lexis-tun-flowqueue.test.mjs b/scripts/lexis-tun-flowqueue.test.mjs
new file mode 100644
index 0000000..d873ad2
--- /dev/null
+++ b/scripts/lexis-tun-flowqueue.test.mjs
@@ -0,0 +1,81 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { buildTcpPacket, buildUdpPacket, createFlowQueue, flowKeyOf } from "../public/agent/lexis-tun.mjs";
+
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const tcp = (sport, seq) => buildTcpPacket({ src: "10.7.0.1", dst: "45.67.90.10", sport, dport: 80, seq, ack: 0, flags: 0x10, payload: Buffer.from([seq & 0xff]) });
+const udp = (sport, b) => buildUdpPacket({ src: "10.7.0.1", dst: "45.67.90.10", sport, dport: 53, payload: Buffer.from([b]) });
+
+test("flowKeyOf separates protocol and both endpoints", () => {
+  assert.notEqual(flowKeyOf(tcp(1000, 1)), flowKeyOf(tcp(1001, 1)));
+  assert.notEqual(flowKeyOf(tcp(1000, 1)), flowKeyOf(udp(1000, 1)));
+  assert.equal(flowKeyOf(tcp(1000, 1)), flowKeyOf(tcp(1000, 2)));
+});
+
+test("same flow: strictly in order and one at a time, even when early packets are slow", async () => {
+  const order = [];
+  let running = 0, maxRunning = 0;
+  const q = createFlowQueue({
+    capMs: 10000,
+    push: async (p) => {
+      running++; maxRunning = Math.max(maxRunning, running);
+      const seq = p[p.length - 1];
+      await sleep(seq === 0 ? 60 : Math.random() * 10);
+      order.push(seq); running--;
+    },
+  });
+  const all = [];
+  for (let i = 0; i < 20; i++) all.push(q.dispatch(tcp(2000, i)));
+  await Promise.all(all);
+  assert.deepEqual(order, [...Array(20).keys()]);
+  assert.equal(maxRunning, 1);
+});
+
+test("a stalled flow does not block other flows, and stays ordered past the cap", async () => {
+  const done = [], stalls = [];
+  const q = createFlowQueue({
+    capMs: 50,
+    onStall: (k) => stalls.push(k),
+    push: async (p) => {
+      const isSlow = flowKeyOf(p) === flowKeyOf(udp(5353, 0));
+      if (isSlow && p[p.length - 1] === 0) await sleep(200); // e.g. UDP open during an outage
+      done.push(`${isSlow ? "slow" : "fast"}${p[p.length - 1]}`);
+    },
+  });
+  const slow0 = q.dispatch(udp(5353, 0));
+  const slow1 = q.dispatch(udp(5353, 1));
+  await Promise.all([q.dispatch(tcp(3000, 1)), q.dispatch(tcp(3001, 2)), q.dispatch(udp(4000, 3))]);
+  assert.deepEqual(done, ["fast1", "fast2", "fast3"], "other flows finished while the slow one waits");
+  await Promise.all([slow0, slow1]);
+  assert.deepEqual(done.slice(3), ["slow0", "slow1"], "slow flow kept its order beyond the cap");
+  assert.equal(stalls.length, 1);
+});
+
+test("bounds: per-flow depth drops extra packets; reader waits at maxInflight", async () => {
+  let release;
+  const gate = new Promise((r) => (release = r));
+  const drops = [];
+  const q = createFlowQueue({ capMs: 10000, perFlowMax: 3, maxInflight: 5, onDrop: (k) => drops.push(k), push: () => gate });
+  for (let i = 0; i < 5; i++) q.dispatch(tcp(6000, i));
+  assert.equal(drops.length, 2);
+  assert.equal(q.inflight, 3);
+  q.dispatch(tcp(6001, 0)); q.dispatch(tcp(6002, 0));
+  assert.equal(q.inflight, 5);
+  let ready = false;
+  void q.ready().then(() => (ready = true));
+  await sleep(10);
+  assert.equal(ready, false, "reader paused at maxInflight");
+  release();
+  await sleep(10);
+  assert.equal(ready, true);
+  assert.equal(q.inflight, 0);
+  assert.equal(q.flows, 0);
+});
+
+test("push errors are reported and do not wedge the flow", async () => {
+  const errs = [], seen = [];
+  const q = createFlowQueue({ capMs: 1000, onError: (e) => errs.push(e.message), push: async (p) => { const s = p[p.length - 1]; if (s === 0) throw new Error("x"); seen.push(s); } });
+  await Promise.all([q.dispatch(tcp(7000, 0)), q.dispatch(tcp(7000, 1))]);
+  assert.deepEqual(errs, ["x"]);
+  assert.deepEqual(seen, [1]);
+});
diff --git a/scripts/lexis-tun-loopguard.test.mjs b/scripts/lexis-tun-loopguard.test.mjs
