+const TIMEOUT = 1500;
+function timed(p) { return Promise.race([p, new Promise((_, rej) => setTimeout(() => rej(Object.assign(new Error("timeout"), { code: "TIMEOUT" })), TIMEOUT))]); }
+function tcpEcho(host, port, payload) {
