+  for (let j = 0; j < 10; j++) {
+    const pos = j < 8 ? ws.length - 1 - j : Math.floor(Math.random() * ws.length), ww = [...ws];
+    let s; do { s = S.words[Math.floor(Math.random() * 3000)]; } while (s === ww[pos]); ww[pos] = s;
+    tested++; try { F.openV2({ ...o, prose: ww.join(" ") }); } catch { rejected++; }
