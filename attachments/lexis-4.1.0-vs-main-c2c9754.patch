+function udpRound(host, port, payload, check) {
+  const s = createSocket(host.includes(":") ? "udp6" : "udp4");
+  return timed(new Promise((res, rej) => {
+    s.on("error", rej);
+    s.connect(port, host, (err) => { if (err) return rej(err); s.send(payload, (e) => { if (e) rej(e); }); });
